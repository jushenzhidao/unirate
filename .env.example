# 这是**模板**，不是可用配置。
#
# 不要 `cp .env.example .env` —— 下面的凭证是刻意写成不可用的占位符，
# 直接复制会让 compose 与网关双双拒绝启动（这是设计意图，不是故障）。
#
# 正确做法：
#     make init
#
# 它会生成 .env 并用 `openssl rand -base64 24` 填入强随机凭证。
#
# 为什么不给默认值：本仓库曾给 ADMIN_TOKEN 配过默认值
# change-me-admin-token-32chars-min，实测用它可直接访问管理面（HTTP 200）。
# 公开在仓库里的凭证等于没有凭证，而占位默认值比空值更危险 ——
# 它看起来像"已经配好了"，没人会去复查。
# 因此：所有凭证在 docker-compose.yml 中声明为 ${VAR:?...}（必填），
# 且网关会在启动时拒绝弱令牌与本文件出现过的全部占位值。

# ---- 端口映射（宿主侧）----
PROXY_PORT=28080
OBS_PORT=29091
# Admin 端口只绑 127.0.0.1，不对外暴露。不要改成 0.0.0.0。
ADMIN_PORT=29090
PROM_PORT=29092
GRAFANA_PORT=29093

# ---- 凭证（必须由 make init 生成，占位值会被拒绝）----
# ADMIN_TOKEN 要求：≥32 字符、不在弱值黑名单（含本文件所有占位值）
ADMIN_TOKEN=<RUN make init TO GENERATE>
REDIS_PASSWORD=<RUN make init TO GENERATE>
GRAFANA_PASSWORD=<RUN make init TO GENERATE>

# 已无 MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD：配置 SoT 改为网关进程内嵌的
# SQLite（compose 里的 STORE_DSN），默认编排不含数据库容器，无需数据库凭证。
# 若要改回外置 MySQL，在此自行填 STORE_DSN 并管理该库凭证。

# Admin 来源白名单（CIDR，逗号分隔）。留空表示只依赖 Token 鉴权。
# 刻意保留在环境变量：若能从管理页面改，攻击者拿到令牌后可自行放开来源限制，
# 等于自毁第二重防线（见 docs/decisions/CONFIG-TIERING.md）。
ADMIN_ALLOW_CIDRS=172.16.0.0/12,10.0.0.0/8,127.0.0.0/8,192.168.0.0/16

# ---- 运行参数 ----
# 以下两项属 Tier 1，也可在管理页面热改（页面值优先于此处）。
# 见 docs/DEPLOYMENT.md「配置分层」。
LOG_LEVEL=info
VERSION=dev

# ---- 镜像来源（留空即本地构建）----
# 默认走本地构建：docker compose up -d --build，镜像名 unirate/gateway:${VERSION}。
# 想直接用 CI 发布到 GHCR 的预构建镜像（省去本地编译），取消下面两行注释：
#
#   GATEWAY_IMAGE=ghcr.io/jushenzhidao/unirate:0.1.4
#   GATEWAY_PULL_POLICY=always
#
# 然后用 docker compose pull && docker compose up -d 启动 —— 不要带 --build，
# 否则 compose 仍会本地构建并把结果覆盖到这个 tag 上，等于白拉。
#
# 两点实测注意：
#   1. GHCR 的语义化 tag 不带 v 前缀（0.1.4 而非 v0.1.4），写错会 404；
#   2. 不要把 GATEWAY_IMAGE 写成 :${VERSION}——VERSION 默认 dev，
#      而 GHCR 上没有 dev 这个 tag。两者是不同维度，刻意不复用。
# 可用 tag：latest、main、0.1.4 等，含 linux/amd64 与 linux/arm64。

# ---- 可选：SSRF 白名单 ----
# 仅在把 compose 里的 ALLOW_HEADER_UPSTREAM 改成 true 时才需要填。
# 留空且保持 false 是默认的安全形态。
#UPSTREAM_ALLOWLIST=api.openai.com,api.anthropic.com

# ---- 可选：Logfire 指标外发（--profile logfire）----
# 启动：docker compose --profile logfire up -d
# 与 --profile obs（本地 Prometheus+Grafana）互不干扰，可同时开用于迁移期比对。
#
# LOGFIRE_TOKEN 是 Tier 0 凭证，没有默认值。启用 logfire profile 时必须填，
# 否则 Collector 会带占位串 LOGFIRE_TOKEN-NOT-SET 启动，Logfire 持续返回
# 401 且不断重试 —— 数据一条都上不去。判断方法：Collector 日志里搜
# LOGFIRE_TOKEN-NOT-SET，命中即说明这里没配。
# （otelcol v0.115.1 不支持配置文件级必填校验，无法做到缺失即启动失败。）
#LOGFIRE_TOKEN=<your logfire write token>
# 按账号区域选择：美区 logfire-us / 欧区 logfire-eu，写错会一直 4xx。
#LOGFIRE_ENDPOINT=https://logfire-us.pydantic.dev

# 指标降频只能靠拉长抓取间隔。不要对指标做概率采样 ——
# 会破坏 counter 单调性，令 rate() 出现负值。
#OTEL_SCRAPE_INTERVAL=15s
#OTEL_LOG_LEVEL=warn
# 排障时设 detailed 可在 Collector 日志里看到实际抓到的指标
#OTEL_DEBUG_VERBOSITY=basic
# 写入 external_labels 的 env 标签，用于区分多环境数据
#DEPLOY_ENV=dev
#OTEL_COLLECTOR_VERSION=0.115.1

# 迁移必办：deploy/prometheus/rules.yml 的告警需在 Logfire 侧重建，
# 其中 RateLimiterDegraded（unirate_redis_breaker_open > 0）必须保留 ——
# 限流静默失效没有任何用户可见症状，丢了这条等于丢了最重要的告警。
