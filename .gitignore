# 覆盖率与测试产物
coverage.out
coverage.html
*.test
*.prof

# 本地环境配置：含 ADMIN_TOKEN 与数据库密码，绝不入库
# 需要新环境时从 .env.example 复制
.env
.env.local

# SQLite 本地数据：配置 SoT 与审计日志，含业务域名单
# STORE_DSN 留空时落在 data/unirate.db；-wal/-shm 是 WAL 模式的侧车文件
/data/
*.db
*.db-wal
*.db-shm

# 编译产物
# 必须用 / 锚定到仓库根，否则会连带忽略 cmd/gateway、cmd/mockupstream 源码目录
/bin/
/dist/
/gateway
/mockupstream

# 编辑器与系统
.DS_Store
*.swp
.idea/
.vscode/

# 本地 AI 助手工作区数据，不入库
.workbuddy/
